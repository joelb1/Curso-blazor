@page "/usuario"
@using sharpness_sharp.Components.Pages.UIComponents
@using sharpness_sharp.Data
@inject ApplicationAuthDbContext _dbService



<div class="grid grid-cols-4 gap-4 p-4 bg-gray-400 min-h-screen">
    @foreach (ApplicationUser user in lstUsuarios)
    {
        <div class="border">
            <h2>Username: @user.UserName</h2>
            <p>Email: @user.Email</p>
        </div>

    }
</div>
 
 
@code {
private List<ApplicationUser> lstUsuarios = new();


protected override Task OnInitializedAsync()
    {
        lstUsuarios = _dbService.Users.ToList();
        return base.OnInitializedAsync();
    }
}