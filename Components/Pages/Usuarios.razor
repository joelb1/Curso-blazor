@page "/usuario"
<div class="grid grid-cols-4 gap-4 p-4 bg-gray-400 min-h-screen">
    @foreach (Usuario usuario in lstUsuarios)
    {
        <div class="flex flex-col justify-center border-2 w-10vw rounded-md p-4 m-2 gap-2">
            <h2 class="text-bold text-2xl">@usuario.Nombre</h2>
            <p><b>Descripción: </b>@usuario.CodigoUnivalle</p>
            <p class="font-bold text-red-500 p-3">@usuario.Sexo en toda la run</p>
        </div>
    }
</div>
 
 
