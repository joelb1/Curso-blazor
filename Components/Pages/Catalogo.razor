@page  "/catalogo"

@foreach (Cafe cafe in lstCafes){
    
<div class="flex items-center justify-center flex-col gap-2 border-2 border-2 border-gray-300 rounded-lg p-4 m-2"> 
    <img src="@cafe.Imagen"/>
    <h2>@cafe.NombreCafe</h2>
    <p>@cafe.DescripcionCafe</p>
    <p>@cafe.PrecioCafe Bs.</p>
</div>
}
