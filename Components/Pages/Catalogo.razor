@page "/catalogo"
    @using sharpness_sharp.Components.Pages.UIComponents
@using sharpness_sharp.Data.Models
@using sharpness_sharp.Data
@inject ApplicationAuthDbContext _dbService

<EditForm FormName="agregar-cafe" Model="@newCafe" OnSubmit="AgregarCafe">
    <InputText @bind-Value="newCafe.Imagen" class="border-2 px-2" aria-placeholder="introduce la url de la imagen"/>
    <InputText @bind-Value="newCafe.NombreCafe" class="border-2 px-2" aria-placeholder="introduce el nombre del café"/>
    <InputText @bind-Value="newCafe.DescripcionCafe" class="border-2 px-2" aria-placeholder="introduce la descripción del café"/>
    <InputNumber @bind-Value="newCafe.PrecioCafe" class="border-2 px-2" aria-placeholder="introduce el precio del café"/>

<button type="submit">Guardar</button>
</EditForm>
 
<div class="grid grid-cols-4 gap-4 p-4">
    @foreach (Cafe cafe in lstCafes)
    {
        <CoffeeCard Imagen="@cafe.Imagen" NombreCafe="@cafe.NombreCafe" DescripcionCafe="@cafe.DescripcionCafe"
                    PrecioCafe="@cafe.PrecioCafe"></CoffeeCard>
    }
</div>
 
@code {
    private Cafe newCafe = new();
    private List<Cafe> lstCafes = new();
    protected override Task OnInitializedAsync()
    {
        lstCafes = _dbService.Cafes.ToList();
        return base.OnInitializedAsync();
    }
    private Task AgregarCafe()
    {
        _dbService.Cafes.Add(newCafe);
        _dbService.SaveChanges();
        newCafe = new ();
        return Task.CompletedTask;
    }
}